{
  "name": "@kenn-io/roborev-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "generate": "bun run scripts/generate-api.ts",
    "generate:check": "bun run scripts/generate-api.ts --check",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run generate:check && bun run typecheck && bun run lint && bun run format:check",
    "test": "vitest run",
    "test:e2e": "bun run scripts/e2e.ts",
    "build": "vite build",
    "assets:check": "bun run scripts/validate-assets.ts dist",
    "assets:embed": "bun run scripts/embed-assets.ts dist",
    "assets:restore": "bun run scripts/embed-assets.ts --restore-stub",
    "dev:full": "bun run scripts/dev.ts",
    "dev": "vite"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-beta.102",
    "@kenn-io/kit-ui": "github:kenn-io/kit-ui#97be355ef25a02ce96de6da4f3627ed5b922c4c3",
    "@kenn-io/roborev-ui": "workspace:*",
    "@lucide/svelte": "1.23.0",
    "dompurify": "3.4.13",
    "effect": "4.0.0-beta.102",
    "marked": "18.0.5",
    "mermaid": "11.16.1",
    "openapi-fetch": "0.17.0",
    "shiki": "4.3.0",
    "svelte": "5.56.4"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.102",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.10.0",
    "eslint": "9.39.2",
    "eslint-plugin-svelte": "3.15.0",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "playwright": "1.61.1",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.4.1",
    "svelte-check": "4.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
}
