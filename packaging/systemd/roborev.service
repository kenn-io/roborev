[Unit]
Description=roborev code review daemon
Documentation=https://github.com/roborev-dev/roborev

[Service]
Type=notify
# The packaged unit has no repository context, so keep its default root stable.
WorkingDirectory=%h
ExecStart=/usr/bin/roborev daemon run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
