{#-
  Zensical only includes nav pages in the sitemap; the docs index is not in the
  nav, and the build copies this file to the site root, so index the website
  tier and the docs index here.
-#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://roborev.io/</loc>
  </url>
  <url>
    <loc>https://roborev.io/guide/</loc>
  </url>
  <url>
    <loc>https://roborev.io/docs/</loc>
  </url>
  {%- for page in pages -%}
    {%- if page.canonical_url %}
      <url>
        <loc>{{ page.canonical_url }}</loc>
      </url>
    {%- endif -%}
  {%- endfor %}
</urlset>
