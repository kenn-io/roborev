{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "timezone": "America/New_York",
  "dependencyDashboard": true,
  "enabledManagers": ["github-actions", "gomod", "pep621"],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "constraints": {
    "ghActionsLock": "v0.3.0"
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "prCreation": "immediate",
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "groupSlug": "go-dependencies",
      "postUpdateOptions": ["gomodUpdateImportPaths", "gomodTidy"]
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "Docs dependencies",
      "groupSlug": "docs-dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions dependencies",
      "groupSlug": "github-actions-dependencies"
    },
    {
      "description": ["kenn-io releases open right away: no release-age wait and no weekly window."],
      "matchPackageNames": ["kenn-io/**", "github.com/kenn-io/**", "go.kenn.io/**", "@kenn-io/**"],
      "groupName": "kenn-io dependencies",
      "groupSlug": "kenn-io-dependencies",
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    },
    {
      "description": [
        "Show the kit action under the Go module path go.kenn.io/kit in PR tables, so both kit updates read as one package.",
        "overrideDepName cannot do this: the github-actions manager writes `uses:` lines from depName, so it would write go.kenn.io/kit/... into workflows."
      ],
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["kenn-io/kit"],
      "prBodyDefinitions": {
        "Package": "{{{replace '^\\[kenn-io/kit\\]' '[go.kenn.io/kit]' depNameLinked}}}{{#if newName}}{{#unless (equals depName newName)}} \u2192 {{{newNameLinked}}}{{/unless}}{{/if}}"
      }
    }
  ]
}
