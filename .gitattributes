bun.lock linguist-generated=true
mise.lock linguist-generated=true
docs/uv.lock linguist-generated=true
docs/screenshots/package-lock.json linguist-generated=true

# make api-generate: OpenAPI document and Go client. config.yaml, the overlays,
# the templates, and generate.go are hand-written generator inputs.
