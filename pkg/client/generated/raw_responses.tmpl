{{- /*
This template emits only the envelope type declarations (the wrapper struct
and per-status typed header structs). Output is appended to responses.go so
the wrapper sits next to the body type aliases it references. No header /
imports / package decl - those come from the surrounding file.
*/ -}}

{{ define "client-with-response-types" }}
{{- $args := . -}}
{{- $operations := $args.operations -}}
{{- $config := $args.config -}}

{{- range $operations }}{{ $op := . }}
{{- range $rcd := $op.Response.EnvelopeResponses }}
{{- if gt (len $rcd.Headers) 0 }}
type {{ $op.HeaderTypeName $rcd }} struct {
    {{- range $hName, $hSchema := $rcd.Headers }}
    {{ genTypeName $hName }} string `header:"{{ escapeGoString $hName }}"`
    {{- end }}
}
{{ end -}}
{{- if $op.Response.HasLegacyHeaders $rcd }}
// Deprecated: Use {{ $op.HeaderTypeName $rcd }}.
type {{ index $op.HeaderTypeNames $rcd.StatusCode }} = {{ $op.HeaderTypeName $rcd }}
{{ end -}}
{{- end }}

type {{$op.WithResponseTypeName}} struct {
    HTTPResponse *http.Response
    Body         []byte
    StatusCode   int
    {{- range $rcd := $op.Response.EnvelopeResponses }}
        {{- if and (ne $rcd.ResponseName "struct{}") (not $rcd.IsRaw) (ne $rcd.NameTag "") }}
    {{$rcd.NameTag}}{{$rcd.StatusName}} *{{$rcd.ResponseName}}
        {{- end }}
        {{- /* Earlier versions named a range's field after its stand-in
               code, such as JSON400 for 4XX. Kept so their callers compile. */ -}}
        {{- with $op.Response.LegacyBodyField $rcd }}
    // Deprecated: Use {{$rcd.NameTag}}{{$rcd.StatusName}}, which this always equals.
    {{.}} *{{$rcd.ResponseName}}
        {{- end }}
        {{- /* Populated by the streaming sibling, never by the same call as
               the buffered body field. */ -}}
        {{- if $config.Generate.ClientStreaming }}
        {{- with $op.Response.StreamFor $rcd }}
    Stream{{.StatusCode}} *runtime.Stream[{{.ItemName}}]
        {{- end }}
        {{- end }}
        {{- if gt (len $rcd.Headers) 0 }}
    Headers{{$rcd.StatusName}} *{{ $op.HeaderTypeName $rcd }}
        {{- end }}
        {{- if $op.Response.HasLegacyHeaders $rcd }}
    // Deprecated: Use Headers{{$rcd.StatusName}}, which this always equals.
    Headers{{$rcd.StatusCode}} *{{ index $op.HeaderTypeNames $rcd.StatusCode }}
        {{- end }}
    {{- end }}
}

{{ end }}{{- /* end range operations */ -}}
{{ end -}}

{{ template "client-with-response-types" dict "operations" .Operations "config" .Config }}

// RawClient uses generated request options without buffering response bodies.
// Callers own and must close each response body.
type RawClient struct {
    apiClient runtime.APIClient
    doer runtime.HttpRequestDoer
}

func NewRawClient(apiClient runtime.APIClient, doer runtime.HttpRequestDoer) *RawClient {
    return &RawClient{apiClient: apiClient, doer: doer}
}

{{range .Operations}}{{$op := .}}
func (c *RawClient) {{$op.ID}}Raw(ctx context.Context{{ if $op.HasRequestOptions }}, options *{{$op.ID | ucFirst}}RequestOptions{{end}}, reqEditors ...runtime.RequestEditorFn) (*http.Response, error) {
    {{if $op.HasRequestOptions}}if options == nil { options = &{{$op.ID | ucFirst}}RequestOptions{} }{{end}}
    req, err := c.apiClient.CreateRequest(ctx, runtime.RequestOptionsParameters{
        RequestURL: c.apiClient.GetBaseURL() + "{{escapeGoString $op.Path}}",
        Method: "{{$op.Method}}",
        {{if $op.HasRequestOptions}}Options: options,{{end}}
        {{if $op.Body}}ContentType: "{{$op.Body.ContentType}}",{{end}}
    }, reqEditors...)
    if err != nil { return nil, fmt.Errorf("error creating request: %w", err) }
    return c.doer.Do(ctx, req)
}
{{end}}
